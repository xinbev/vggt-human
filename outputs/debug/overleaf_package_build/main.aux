\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Qualitative comparison of human--scene geometric interaction.} Each row shows the input image, UniSH, Human3R, and our joint human--scene reconstruction from left to right. Compared with the floating, penetration, and depth misalignment visible in the baselines, our method obtains root positions that better conform to scene surfaces and more coherent support relationships while preserving local human pose and shape. This figure provides qualitative evidence of geometric interaction; global motion and metric-scene performance are evaluated quantitatively in Table~\ref {tab:global-motion} and Appendix Table~\ref {tab:bonn-depth}, respectively.}}{16}{figure.4}\protected@file@percent }
\newlabel{fig:human-scene-interaction}{{4}{16}{\textbf {Qualitative comparison of human--scene geometric interaction.} Each row shows the input image, UniSH, Human3R, and our joint human--scene reconstruction from left to right. Compared with the floating, penetration, and depth misalignment visible in the baselines, our method obtains root positions that better conform to scene surfaces and more coherent support relationships while preserving local human pose and shape. This figure provides qualitative evidence of geometric interaction; global motion and metric-scene performance are evaluated quantitatively in Table~\ref {tab:global-motion} and Appendix Table~\ref {tab:bonn-depth}, respectively}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}General 3D Reconstruction}{16}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {General 3D reconstruction evaluation.} (a) Camera-trajectory ATE on TUM-Dynamic as the number of input views changes; (b-c) Abs Rel and $\delta <1.25$ on Bonn as the requested number of input views changes. The blue VGGT-Ω ATE curve is obtained from our exact evaluator; the camera and depth reference curves are approximately digitized from Fig. 9 of Human3R. The red Bonn curves are an oracle diagnostic for Pure VGGT + GT scale: each sequence and input prefix uses a scale fitted from GT, only to analyze a measurable upper bound of VGGT-Ω relative geometry, not as a privileged prediction of our method. The x-axis is the requested maximum number of views; shorter sequences use all available frames without repeated padding.}}{17}{figure.5}\protected@file@percent }
\newlabel{fig:general-reconstruction}{{5}{17}{\textbf {General 3D reconstruction evaluation.} (a) Camera-trajectory ATE on TUM-Dynamic as the number of input views changes; (b-c) Abs Rel and $\delta <1.25$ on Bonn as the requested number of input views changes. The blue VGGT-Ω ATE curve is obtained from our exact evaluator; the camera and depth reference curves are approximately digitized from Fig. 9 of Human3R. The red Bonn curves are an oracle diagnostic for Pure VGGT + GT scale: each sequence and input prefix uses a scale fitted from GT, only to analyze a measurable upper bound of VGGT-Ω relative geometry, not as a privileged prediction of our method. The x-axis is the requested maximum number of views; shorter sequences use all available frames without repeated padding}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Qualitative comparison of real-world measurements.} The two columns show different indoor scenes; the three rows show Ground Truth, MapAnything, and our method. Red annotations denote human heights or object lengths measured from reconstructed geometry; quantitative results are given in Appendix Table~\ref {tab:bonn-depth}.}}{18}{figure.6}\protected@file@percent }
\newlabel{fig:metric-measurement}{{6}{18}{\textbf {Qualitative comparison of real-world measurements.} The two columns show different indoor scenes; the three rows show Ground Truth, MapAnything, and our method. Red annotations denote human heights or object lengths measured from reconstructed geometry; quantitative results are given in Appendix Table~\ref {tab:bonn-depth}}{figure.6}{}}
